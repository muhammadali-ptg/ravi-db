# GoHighLevel API v2 (LeadConnector) credentials.
#
# GHL_API_TOKEN: a Private Integration token (recommended) or an OAuth access
# token for the sub-account. Create one in the sub-account under
# Settings -> Private Integrations, and grant these scopes:
#   opportunities.readonly
#   contacts.readonly
#   conversations.readonly
#   conversations/message.readonly
#   forms.readonly
GHL_API_TOKEN=

# The sub-account (location) the pipeline lives in.
GHL_LOCATION_ID=

# Optional. Defaults to the public LeadConnector API host.
# GHL_API_BASE=https://services.leadconnectorhq.com

# Optional. Default pipeline for `ghl-report report` when --pipeline is omitted.
# GHL_PIPELINE_ID=
